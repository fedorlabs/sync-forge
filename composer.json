{
  "name": "fedorlabs/sync-forge",
  "description": "Symfony-compatible reconciliation engine for bulk sync via DBAL",
  "keywords": ["sync", "reconciliation", "doctrine", "dbal", "symfony", "upsert"],
  "homepage": "https://github.com/fedorlabs/sync-forge",
  "support": {
    "issues": "https://github.com/fedorlabs/sync-forge/issues",
    "source": "https://github.com/fedorlabs/sync-forge"
  },
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^4.2",
    "symfony/config": "^6.4 || ^7.0 || ^8.1",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.1",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.66",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "doctrine/orm": "Required to use DoctrineOrmEntityMetadataProvider bridge"
  },
  "autoload": {
    "psr-4": {
      "SyncForge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SyncForge\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testsuite Unit && vendor/bin/phpunit --filter SyncPipelineSqliteTest",
    "test-unit": "vendor/bin/phpunit --testsuite Unit",
    "test-integration": "vendor/bin/phpunit --filter SyncPipelineSqliteTest",
    "test-integration-external": "vendor/bin/phpunit --filter \"SyncPipeline(Postgres|MySql)Test\"",
    "lint": "find src tests config -name '*.php' -print0 | xargs -0 -n1 php -l",
    "analyse": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
    "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --dry-run --diff",
    "cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
    "bench:up": "docker compose -f benchmarks/docker-compose.yml up -d",
    "bench:down": "docker compose -f benchmarks/docker-compose.yml down -v",
    "bench:run": "php benchmarks/run.php"
  }
}
